# Local Mac setup (default): ChatGPT subscription through the installed Codex CLI.
AGENT_PROVIDER=codex
COMPUTER_PROVIDER=local
# CODEX_BIN=/Applications/ChatGPT.app/Contents/Resources/codex-cli/bin/codex
# CLAUDE_BIN=/Users/YOUR_USER/.local/bin/claude
# CLAUDE_MODEL=        # account default, or sonnet / opus / haiku
# CODEX_MODEL=         # omitted: use the model configured in Codex
# LIMA_BIN=/Users/YOUR_USER/.local/grokbot-runtime/bin/limactl
# LIMA_INSTANCE=grokbot

# The following keys are optional in local Codex mode.
# Copy to .env and fill in. Never commit .env.
XAI_API_KEY=            # xAI console key; Grokbot runs on grok-4.7
XAI_MODEL=grok-4.7
COMPOSIO_API_KEY=       # Composio project key (ak_...): sign-in, connectors, app marketplace
ORGO_API_KEY=           # Orgo key (sk_live_...) that can create computers in ORGO_WORKSPACE_ID
ORGO_WORKSPACE_ID=      # Orgo workspace holding every user's box
ORGO_RAM_GB=8           # box size: 8 GB / 2 vCPU (Medium); 16/4 recommended for 4 active bots
ORGO_CPU=2
ORGO_RESOLUTION=1280x800x24
PORT=8787
APP_URL=http://localhost:5173     # where the web app is served (redirect target after sign-in)
SERVER_URL=http://localhost:8787  # public URL of this server (OAuth callbacks)
SESSION_SECRET=         # openssl rand -hex 32
DEV_LOGIN=1             # 1 enables POST /api/auth/dev (local testing only)

# Voice (optional; defaults shown). Calls use XAI_API_KEY via short-lived client secrets.
# XAI_VOICE_MODEL=grok-voice-latest
# XAI_STT_MODEL=grok-voice-transcribe-2.0

# Linux server deployment (see infra/server):
# ALLOWED_EMAILS=owner@example.com
# DESKTOP_TRANSPORT=container
# DESKTOP_WS_BIND=0.0.0.0
# DESKTOP_VNC_BASE_PORT=16080
# CODEX_BIN=/opt/grokbot-tools/node_modules/.bin/codex
# CLAUDE_BIN=/usr/local/bin/claude
# DB_PATH=/var/lib/grokbot/grokbot.db
# DEV_LOGIN=0

# ---------- Plans and bring-your-own model ----------
# Set to 0 in production so every user must connect their own ChatGPT account or API key
# (otherwise bots fall back to this server's own Codex/Claude login).
# SHARED_MODEL_LOGIN=0
# 64 hex chars used to encrypt users' API keys. If unset, one is generated in the data folder.
# CREDENTIALS_KEY=
# RevenueCat webhook Authorization header value; the webhook sets plans from App Store purchases.
# REVENUECAT_WEBHOOK_SECRET=
