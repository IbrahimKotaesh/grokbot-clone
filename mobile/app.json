{
  "expo": {
    "name": "Fino",
    "slug": "fino-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ibkopixels.fino",
      "buildNumber": "4",
      "appleTeamId": "345F6K6X7N",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#101820",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.ibkopixels.fino",
      "versionCode": 3
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-sharing",
      "expo-image",
      [
        "expo-audio",
        {
          "microphonePermission": "Record voice messages to transcribe them in your conversation.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos to share with your Fino assistant.",
          "cameraPermission": "Take a photo to share with your Fino assistant."
        }
      ],
      "./plugins/with-scene-delegate",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Record voice messages to transcribe them in your conversation.",
          "speechRecognitionPermission": "Turn your voice messages into text as you speak."
        }
      ],
      "expo-router",
      "expo-apple-authentication"
    ],
    "scheme": "fino"
  }
}
