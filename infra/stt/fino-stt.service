[Unit]
Description=Fino private speech transcription
After=network.target

[Service]
User=fino-stt
Group=fino-stt
WorkingDirectory=/opt/fino-stt
ExecStart=/opt/fino-stt/venv/bin/python /opt/fino-stt/transcribe.py
Environment=OMP_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=2
Environment=HF_HUB_OFFLINE=1
Environment=STT_BEAM_SIZE=3
Environment=STT_DETECTOR_PATH=/var/lib/fino-stt/model-base
Environment=STT_CPU_THREADS=2
Restart=on-failure
RestartSec=5
Nice=10
CPUQuota=175%
MemoryMax=1800M
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
